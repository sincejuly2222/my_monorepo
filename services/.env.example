# HTTP 服务
PORT=3000
NODE_ENV=development
APP_ORIGIN=http://localhost:5173
TRUST_PROXY=0

# 登录鉴权（请使用随机值替换示例密钥，至少 32 字节）
AUTH_JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes
AUTH_JWT_ISSUER=my-monorepo-api
AUTH_JWT_AUDIENCE=my-monorepo-web
AUTH_SESSION_TTL_SECONDS=7200

# MySQL 连接
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=my_user
DB_CONNECTION_LIMIT=10
