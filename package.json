{
  "name": "my-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "基于 pnpm workspace 的多包项目",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --if-present run dev",
    "dev:web": "pnpm --filter @app/web run dev",
    "dev:services": "pnpm --filter @my-monorepo/services run dev",
    "build": "pnpm -r --if-present run build",
    "build:web": "pnpm --filter @app/web run build",
    "build:services": "pnpm --filter @my-monorepo/services run build",
    "prestart": "pnpm run build",
    "start": "pnpm -r --parallel --if-present run start",
    "start:services": "pnpm --filter @my-monorepo/services run start",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "license": "ISC",
  "packageManager": "pnpm@10.8.0",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10",
    "eslint-plugin-react-hooks": "^7",
    "eslint-plugin-react-refresh": "^0.4",
    "globals": "^16",
    "prettier": "^3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8"
  }
}
